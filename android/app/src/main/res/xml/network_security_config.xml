<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- [운영 통신] 평문 HTTP를 차단하고 시스템 신뢰 인증서만 허용합니다. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
